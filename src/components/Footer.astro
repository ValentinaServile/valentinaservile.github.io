---
import { SOCIALS } from '../consts';
import PixelIcon from './PixelIcon.astro';

const today = new Date();
---

<footer>
	<span class="sig">&copy; {today.getFullYear()} // deployed with <3 by Valentina</span>
	<div class="social-links">
		{
			SOCIALS.map((s) => (
				<a href={s.href} target="_blank" rel="me noopener">
					<span class="sr-only">{s.label}</span>
					<PixelIcon name={s.id} />
				</a>
			))
		}
	</div>
</footer>
<style>
	footer {
		position: relative;
		margin-top: 5em;
		padding: 3em 1em 3em 1em;
		text-align: center;
		color: var(--dim);
		font-size: 0.85rem;
		border-top: 1px solid var(--line);
		overflow: hidden;
	}
	footer::before {
		content: '';
		position: absolute;
		top: -1px;
		left: 0;
		right: 0;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--neon-magenta), var(--neon-cyan), transparent);
	}
	footer > :global(*) {
		position: relative;
		z-index: 1;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1.2em;
		margin-top: 1em;
	}
	.social-links a {
		display: flex;
		color: var(--dim);
		border: none;
	}
	.social-links a:hover {
		color: var(--blue);
		text-shadow: var(--glow-blue);
	}
</style>
