---
/**
 * Hand-drawn 12x12 pixel-art icons.
 *
 * Each glyph is a literal picture in the source: '#' is a filled pixel, '.' is empty.
 * Edit the art by editing the grid — no vector tooling, no external asset, no licence.
 * Adjacent filled pixels in a row are merged into one <rect>, so a glyph costs a
 * handful of nodes rather than one per pixel.
 */

const GRIDS = {
	github: [
		'..#......#..',
		'.###....###.',
		'.##########.',
		'############',
		'##.######.##',
		'############',
		'############',
		'.##########.',
		'..###..###..',
		'...##..##...',
		'...##..##...',
		'............',
	],
	linkedin: [
		'............',
		'.##.........',
		'.##.........',
		'............',
		'.##..######.',
		'.##..##..##.',
		'.##..##..##.',
		'.##..##..##.',
		'.##..##..##.',
		'.##..##..##.',
		'............',
		'............',
	],
} as const;

interface Props {
	name: keyof typeof GRIDS;
	size?: number;
}

const { name, size = 22 } = Astro.props;
const grid = GRIDS[name];

// Merge horizontal runs of filled pixels into single rects.
const rects: { x: number; y: number; w: number }[] = [];
grid.forEach((row, y) => {
	let x = 0;
	while (x < row.length) {
		if (row[x] === '#') {
			let w = 0;
			while (row[x + w] === '#') w++;
			rects.push({ x, y, w });
			x += w;
		} else {
			x++;
		}
	}
});
---

<svg
	width={size}
	height={size}
	viewBox="0 0 12 12"
	shape-rendering="crispEdges"
	aria-hidden="true"
	focusable="false"
>
	{rects.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill="currentColor" />)}
</svg>
