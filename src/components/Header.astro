---
import { SITE_TITLE, SOCIALS } from '../consts';
import PixelIcon from './PixelIcon.astro';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="brand" href="/">
			<span class="prompt">&gt;</span>{SITE_TITLE}<span class="caret">_</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home<span class="hint">h</span></HeaderLink>
			<HeaderLink href="/blog">Blog<span class="hint">b</span></HeaderLink>
			<HeaderLink href="/about">About<span class="hint">a</span></HeaderLink>
		</div>
		<div class="social-links">
			{
				SOCIALS.map((s) => (
					<a href={s.href} target="_blank" rel="me noopener">
						<span class="sr-only">{s.label}</span>
						<PixelIcon name={s.id} />
					</a>
				))
			}
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 400;
		background: rgba(7, 1, 15, 0.85);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--line);
	}
	/* neon underline on the header edge */
	header::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 1px;
		background: linear-gradient(90deg, var(--neon-magenta), var(--purple), var(--neon-cyan));
		opacity: 0.9;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5em;
		width: 1100px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 0.7em 0;
	}

	.brand {
		font-weight: 700;
		font-size: 1rem;
		letter-spacing: 0.06em;
		color: var(--rose);
		text-shadow: var(--glow-rose);
		border: none;
		white-space: nowrap;
	}
	.brand:hover {
		color: var(--pink);
	}
	.prompt {
		color: var(--blue);
		margin-right: 0.4em;
	}
	.caret {
		animation: blink 1.1s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.internal-links {
		display: flex;
		gap: 1.5em;
	}
	.internal-links :global(a) {
		position: relative;
		color: var(--dim);
		border: none;
		text-transform: uppercase;
		font-size: 0.85rem;
		letter-spacing: 0.08em;
	}
	.internal-links :global(a::before) {
		content: '[';
		opacity: 0;
		color: var(--blue);
	}
	.internal-links :global(a::after) {
		content: ']';
		opacity: 0;
		color: var(--blue);
	}
	.internal-links :global(a:hover),
	.internal-links :global(a.active) {
		color: var(--blue);
		text-shadow: var(--glow-blue);
	}
	.internal-links :global(a:hover::before),
	.internal-links :global(a:hover::after),
	.internal-links :global(a.active::before),
	.internal-links :global(a.active::after) {
		opacity: 1;
	}

	.hint {
		display: inline-block;
		margin-left: 0.45em;
		font-size: 0.7em;
		color: var(--purple);
		opacity: 0.55;
	}

	.social-links {
		display: flex;
		gap: 0.9em;
	}
	.social-links a {
		display: flex;
		color: var(--dim);
		border: none;
	}
	.social-links a:hover {
		color: var(--rose);
	}

	@media (max-width: 720px) {
		nav {
			flex-wrap: wrap;
			gap: 0.6em;
		}
		.social-links {
			display: none;
		}
		.hint {
			display: none;
		}
	}
</style>
