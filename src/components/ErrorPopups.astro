---
/**
 * Vaporwave Windows 95 dialogs that drift across the hero, one every few seconds.
 *
 * The content lives in `src/data/error-messages.json` — title, message and button
 * labels — so writing a new joke never means touching this file. Every dialog is
 * rendered here at build time and starts `hidden`; the script only ever unhides one and
 * places it. That keeps the client side down to positioning: no templating, no
 * `innerHTML`, and text that has been through Astro's escaping like any other content.
 *
 * Every button dismisses. They are jokes, not decisions.
 */

import config from '../data/error-messages.json';

const { intervalSeconds = 5, maxOnScreen = 3, dialogs } = config;

// Fail the build loudly rather than shipping a hero that silently does nothing.
if (!Array.isArray(dialogs) || dialogs.length === 0) {
	throw new Error('error-messages.json: "dialogs" must be a non-empty array');
}
dialogs.forEach((dialog, i) => {
	if (!dialog.title || !dialog.message || !dialog.buttons?.length) {
		throw new Error(
			`error-messages.json: dialog ${i} needs a title, a message and at least one button`,
		);
	}
});

const TONES = 4; // see [data-tone] below — cycled so neighbours never share a colour
---

<div
	class="popups"
	data-popups
	data-interval={intervalSeconds * 1000}
	data-max={maxOnScreen}
>
	{
		dialogs.map((dialog, i) => (
			<div class="dialog" data-tone={i % TONES} hidden>
				<div class="bar">
					<span class="title">{dialog.title}</span>
					<button type="button" class="close" aria-label={`Dismiss: ${dialog.title}`}>
						X
					</button>
				</div>
				<div class="body">
					<p class="message">{dialog.message}</p>
					<div class="buttons">
						{dialog.buttons.map((label: string) => (
							<button type="button">{label}</button>
						))}
					</div>
				</div>
			</div>
		))
	}
</div>

<style>
	.popups {
		position: absolute;
		inset: 0;
		/* the whole point: dialogs are clipped by the hero, never spill into the page */
		overflow: hidden;
		/* above .hero-copy (2) — a window that slid under the title would look broken */
		z-index: 3;
		/* the layer is a stage, not a surface: clicks fall through to the CTA beneath */
		pointer-events: none;
	}

	/* Face and edges are mixed from --hue, so a tone is one line to add or change. */
	.dialog[data-tone='0'] {
		--hue: var(--neon-cyan);
	}
	.dialog[data-tone='1'] {
		--hue: var(--neon-magenta);
	}
	.dialog[data-tone='2'] {
		--hue: var(--purple);
	}
	.dialog[data-tone='3'] {
		--hue: var(--blue);
	}

	.dialog {
		--face: color-mix(in srgb, var(--hue) 28%, var(--paper));
		--edge-dark: color-mix(in srgb, var(--hue) 55%, var(--void));

		position: absolute;
		top: 0;
		left: 0;
		width: clamp(11rem, 42%, 16.5rem);
		pointer-events: auto;
		background: var(--face);
		color: var(--void);
		border: 1px solid var(--void);
		/* Win95 bevel: a light inner edge top-left, a dark one bottom-right, and a hard
		   offset drop shadow. No blur anywhere — blur is what makes fake chrome look fake. */
		box-shadow:
			inset 1px 1px 0 var(--paper),
			inset -1px -1px 0 var(--edge-dark),
			3px 3px 0 color-mix(in srgb, var(--void) 60%, transparent);
		animation: pop 0.16s ease-out both;
	}

	/* A class rule beats the UA's [hidden] on specificity, so say it again here. */
	.dialog[hidden] {
		display: none;
	}

	@keyframes pop {
		from {
			opacity: 0;
			transform: scale(0.94);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5em;
		padding: 2px 2px 2px 6px;
		background: var(--hue);
		/* dark on every hue: --paper on cyan is 1.3:1, which is the reference's one flaw */
		color: var(--void);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.04em;
	}

	.title {
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	button {
		background: var(--face);
		color: var(--void);
		border: 1px solid var(--void);
		box-shadow:
			inset 1px 1px 0 var(--paper),
			inset -1px -1px 0 var(--edge-dark);
		font: inherit;
		font-size: 0.72rem;
		line-height: 1;
		cursor: pointer;
	}

	/* pressing inverts the bevel and nudges the label — the whole trick of a 3D button */
	button:active {
		box-shadow:
			inset -1px -1px 0 var(--paper),
			inset 1px 1px 0 var(--edge-dark);
		transform: translate(1px, 1px);
	}

	.close {
		flex: none;
		/* The UA's own button padding (~4.6px x 6.9px) does not fit a box this small, and
		   pushed the X down and to the right. Zero it and centre the glyph outright. */
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		width: 1.2rem;
		height: 1.1rem;
		font-weight: 700;
	}

	.body {
		padding: 1.2em 0.9em 1em;
		text-align: center;
	}

	.message {
		margin: 0 0 1.3em;
		font-size: 0.78rem;
		line-height: 1.5;
		color: var(--void);
	}

	.buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		justify-content: center;
	}

	.buttons button {
		min-width: 5.5em;
		padding: 0.4em 0.9em;
	}
</style>

<script>
	const layer = document.querySelector<HTMLElement>('[data-popups]');
	const hero = layer?.parentElement;

	if (layer && hero) {
		const dialogs = Array.from(layer.querySelectorAll<HTMLElement>('.dialog'));
		const copy = hero.querySelector<HTMLElement>('.hero-copy');
		const interval = Number(layer.dataset.interval);
		const max = Number(layer.dataset.max);
		const still = matchMedia('(prefers-reduced-motion: reduce)');

		const MARGIN = 12; // px of breathing room between a dialog and the hero's edges
		const open: HTMLElement[] = [];
		// Start anywhere in the list, so two visits don't open with the same joke.
		let next = Math.floor(Math.random() * dialogs.length);

		/** A random spot in the layer, preferring one that leaves the wordmark legible. */
		function place(dialog: HTMLElement) {
			const stage = layer!.getBoundingClientRect();
			// offsetWidth, not a rect: the entrance animation starts at scale(0.94), and a
			// rect measures the *transformed* box — which would let a dialog land 6% off-stage.
			const box = { width: dialog.offsetWidth, height: dialog.offsetHeight };
			const text = copy?.getBoundingClientRect();
			// Keep a hair off the edges: a dialog flush against the viewport reads as a
			// clipping bug rather than a window someone left open.
			const spanX = Math.max(0, stage.width - box.width - MARGIN * 2);
			const spanY = Math.max(0, stage.height - box.height - MARGIN * 2);
			let x = 0;
			let y = 0;

			for (let tries = 0; tries < 12; tries++) {
				x = MARGIN + Math.random() * spanX;
				y = MARGIN + Math.random() * spanY;
				if (!text) break;
				const left = stage.left + x;
				const top = stage.top + y;
				const clear =
					left + box.width < text.left ||
					left > text.right ||
					top + box.height < text.top ||
					top > text.bottom;
				if (clear) break; // otherwise keep the last try: a busy hero is the joke
			}

			dialog.style.left = `${x}px`;
			dialog.style.top = `${y}px`;
		}

		function close(dialog: HTMLElement) {
			dialog.hidden = true;
			const at = open.indexOf(dialog);
			if (at > -1) open.splice(at, 1);
		}

		function spawn() {
			const dialog = dialogs[next];
			next = (next + 1) % dialogs.length;
			if (!dialog || open.includes(dialog)) return; // still up: let it have its moment

			// Unhide first — a display:none element has no box to measure or place.
			dialog.hidden = false;
			place(dialog);
			open.push(dialog);

			while (open.length > max) {
				// Never yank a dialog someone is tabbed into.
				const oldest = open.find((d) => !d.contains(document.activeElement));
				if (!oldest) break;
				close(oldest);
			}
		}

		layer.addEventListener('click', (event) => {
			const button = (event.target as HTMLElement).closest('button');
			const dialog = button?.closest<HTMLElement>('.dialog');
			if (dialog) close(dialog);
		});

		// Absolute pixels don't survive a resize; slide strays back inside rather than
		// re-randomising, which would make the hero jump around as you drag a window edge.
		addEventListener('resize', () => {
			const stage = layer.getBoundingClientRect();
			for (const dialog of open) {
				const x = Math.min(
					parseFloat(dialog.style.left),
					Math.max(0, stage.width - dialog.offsetWidth),
				);
				const y = Math.min(
					parseFloat(dialog.style.top),
					Math.max(0, stage.height - dialog.offsetHeight),
				);
				dialog.style.left = `${Math.max(0, x)}px`;
				dialog.style.top = `${Math.max(0, y)}px`;
			}
		});

		if (still.matches) {
			// Reduced motion: one dialog, no animation, nothing that keeps moving.
			spawn();
		} else {
			let timer = 0;
			let onScreen = true;

			const sync = () => {
				const running = onScreen && !document.hidden;
				if (running && !timer) timer = window.setInterval(spawn, interval);
				if (!running && timer) {
					clearInterval(timer);
					timer = 0;
				}
			};

			// No point popping windows at someone reading the archive, or another tab.
			new IntersectionObserver(([entry]) => {
				onScreen = entry.isIntersecting;
				sync();
			}).observe(hero);
			document.addEventListener('visibilitychange', sync);

			setTimeout(spawn, 1200); // let the page settle before the first one lands
			sync();
		}
	}
</script>
