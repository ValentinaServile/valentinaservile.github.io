---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ErrorPopups from '../components/ErrorPopups.astro';
import KeyboardNav from '../components/KeyboardNav.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_NAME, SITE_TITLE } from '../consts';

// Astro has no built-in taxonomy feature, but getCollection() is its own content API —
// an index is just counting the frontmatter it already parsed for us.
const posts = await getCollection('blog');

const tally = (key: 'categories' | 'tags') => {
	const counts = new Map<string, number>();
	for (const post of posts)
		for (const term of post.data[key]) counts.set(term, (counts.get(term) ?? 0) + 1);
	return [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
};

const categories = tally('categories');
const tags = tally('tags');
const years = posts.map((p) => p.data.pubDate.getFullYear());
const span = `${Math.min(...years)}–${Math.max(...years)}`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<section class="hero">
			<div class="glow" aria-hidden="true"></div>
			<div class="grid-floor" aria-hidden="true"></div>
			<div class="hero-copy">
				<h1 class="wordmark">{SITE_NAME}</h1>
				<p class="tagline">{SITE_DESCRIPTION}</p>
				<a class="cta" href="/blog" data-knav>[ read the logs ]</a>
			</div>
			<ErrorPopups />
		</section>

		<main>
			<p class="lede">
				Notes on software delivery, architecture, and other stuff — {posts.length} posts,{' '}
				{span}.
			</p>

			<h2>What's here</h2>
			<p>Broadly two kinds of thing.</p>
			<p>
				<strong>Longer posts</strong> &mdash; on getting software out of the door and keeping it
				maintainable: CI/CD, testing, trunk based development, clean code and architecture.
			</p>
			<p>
				<strong>Snippets</strong> &mdash; short, practical notes from the terminal or whatever programming language I am currently writing in: mostly for my own use, but feel free to copy-paste.
			</p>

			<h2>Categories</h2>
			<ul class="taxo-index">
				{
					categories.map(([name, count]) => (
						<li class="cat">
							{name} <span class="count">{count}</span>
						</li>
					))
				}
			</ul>

			<h2>Tags</h2>
			<ul class="taxo-index">
				{
					tags.map(([name, count]) => (
						<li class="tag">
							#{name} {count > 1 && <span class="count">{count}</span>}
						</li>
					))
				}
			</ul>
		</main>

		<Footer />
		<KeyboardNav />
	</body>
</html>

<style>
	.hero {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 50vh;
		padding: 3em 1em 4.5em;
		overflow: hidden;
		border-bottom: 1px solid var(--line);
	}

	/* Horizon glow: the sun's colours without the sun. Three stacked ellipses, each
	   wider and fainter than the last, centred where the grid meets the sky — so the
	   light still comes from the vanishing point, but nothing competes with the copy. */
	.glow {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(
				ellipse 55% 32% at 50% 62%,
				color-mix(in srgb, var(--neon-magenta) 38%, transparent),
				transparent 70%
			),
			radial-gradient(
				ellipse 85% 45% at 50% 66%,
				color-mix(in srgb, var(--orange) 22%, transparent),
				transparent 72%
			),
			radial-gradient(
				ellipse 120% 60% at 50% 78%,
				color-mix(in srgb, var(--neon-cyan) 14%, transparent),
				transparent 70%
			);
	}

	.hero-copy {
		position: relative;
		z-index: 2;
		text-align: center;
		max-width: 42rem;
	}
	/* Dark scrim: the grid lines cross the tagline and a popup may land behind it, so
	   the copy still needs its own ground. Four stops rather than three, and a lower
	   peak than the sun-era scrim needed — the visible edge of a scrim comes from a
	   steep ramp, not from its size, so the tail does the work. */
	.hero-copy::before {
		content: '';
		position: absolute;
		inset: -1.6em -2.6em;
		z-index: -1;
		background: radial-gradient(
			ellipse at center,
			color-mix(in srgb, var(--void) 60%, transparent) 0%,
			color-mix(in srgb, var(--void) 42%, transparent) 34%,
			color-mix(in srgb, var(--void) 18%, transparent) 62%,
			transparent 84%
		);
	}

	.hero-copy h1 {
		position: relative;
		font-size: clamp(1.9rem, 6vw, 3.2rem);
		margin: 0 0 0.4em 0;
		/* a domain name is lowercase; the global uppercase rule is wrong here */
		text-transform: lowercase;
		letter-spacing: -0.01em;
		color: #fff;
		text-shadow:
			0 0 10px rgba(217, 98, 143, 0.55),
			0 0 34px rgba(217, 98, 143, 0.3),
			1.5px 0 0 rgba(74, 134, 200, 0.4),
			-1.5px 0 0 rgba(217, 98, 143, 0.4);
	}

	.tagline {
		/* one step brighter than the --blue used for links: this is the site's
		   subtitle and sits over the sun, so it needs to carry more than body text */
		color: var(--blue-soft);
		text-shadow:
			0 0 6px rgba(7, 1, 15, 0.95),
			0 0 14px rgba(7, 1, 15, 0.9),
			0 0 3px rgba(111, 163, 220, 0.5),
			0 0 16px rgba(111, 163, 220, 0.25);
		letter-spacing: 0.05em;
		margin-bottom: 2em;
	}

	.lede {
		color: var(--blue-soft);
		font-size: 1.05rem;
	}

	.taxo-index {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		list-style: none;
		margin: 0 0 1.6em 0;
		padding: 0;
		font-size: 0.8rem;
	}
	.taxo-index li {
		margin: 0;
		padding: 0.15em 0.7em;
		border: 1px solid var(--line);
		border-radius: 2px;
		letter-spacing: 0.04em;
	}
	.taxo-index li::marker {
		content: none;
	}
	.taxo-index .cat {
		color: var(--rose);
		border-color: rgba(217, 98, 143, 0.4);
		text-transform: uppercase;
	}
	.taxo-index .tag {
		color: var(--dim);
	}
	.count {
		color: var(--purple);
		opacity: 0.75;
	}

	.cta {
		display: inline-block;
		padding: 0.6em 1.6em;
		color: var(--void);
		background: var(--blue);
		border: none;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		box-shadow: 0 0 24px rgba(0, 229, 255, 0.55);
	}
	.cta:hover {
		color: var(--void);
		background: var(--rose);
		box-shadow: 0 0 30px rgba(255, 46, 151, 0.7);
		text-shadow: none;
	}
</style>
