---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import KeyboardNav from '../../components/KeyboardNav.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>ls -la ./posts</h1>
			<p class="meta">{posts.length} entries &middot; use <kbd>j</kbd>/<kbd>k</kbd> to walk the list</p>

			<ul class="post-list">
				{
					posts.map((post, i) => (
						<li>
							<a href={`/blog/${post.id}/`} data-knav>
								<span class="idx">{String(i + 1).padStart(2, '0')}</span>
								{post.data.heroImage && (
									<Image
										class="thumb"
										width={240}
										height={135}
										src={post.data.heroImage}
										alt=""
									/>
								)}
								<span class="body">
									<span class="title">{post.data.title}</span>
									<span class="desc">{post.data.description}</span>
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</span>
								<span class="arrow" aria-hidden="true">▶</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
		<KeyboardNav />
	</body>
</html>

<style>
	main {
		width: 900px;
	}

	h1 {
		font-size: 1.6rem;
	}
	h1::before {
		content: '$ ';
		color: var(--blue);
	}

	.meta {
		color: var(--dim);
		font-size: 0.85rem;
		margin-bottom: 2.5em;
	}
	kbd {
		padding: 0 0.35em;
		color: var(--yellow);
		background: var(--bg-2);
		border: 1px solid var(--line-hot);
		border-radius: 3px;
		font-family: inherit;
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	/* global `ul li::marker` sets a content string, which survives list-style:none */
	.post-list li::marker {
		content: none;
	}

	.post-list a {
		display: grid;
		grid-template-columns: auto auto 1fr auto;
		align-items: center;
		gap: 1.2em;
		padding: 1em;
		border: 1px solid transparent;
		border-bottom: 1px solid var(--line);
		background: linear-gradient(90deg, rgba(255, 46, 151, 0) 0%, rgba(255, 46, 151, 0) 100%);
		transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
	}

	.post-list a:hover,
	.post-list a:focus-visible {
		outline: none;
		border-color: var(--rose);
		background: linear-gradient(
			90deg,
			rgba(255, 46, 151, 0.18) 0%,
			rgba(0, 229, 255, 0.06) 60%,
			transparent 100%
		);
		transform: translateX(4px);
		box-shadow: -3px 0 0 0 var(--blue);
	}

	.idx {
		font-size: 0.8rem;
		color: var(--purple);
		opacity: 0.7;
	}

	.thumb {
		width: 120px;
		height: 68px;
		object-fit: cover;
		border: 1px solid var(--line);
		border-radius: 3px;
		filter: saturate(1.3) contrast(1.05) hue-rotate(-12deg);
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 0.15em;
		min-width: 0;
	}
	.title {
		color: #fff;
		font-weight: 700;
		letter-spacing: 0.02em;
	}
	.desc {
		color: var(--dim);
		font-size: 0.82rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.date {
		color: var(--blue);
		font-size: 0.75rem;
		opacity: 0.8;
	}

	.arrow {
		color: var(--rose);
		opacity: 0;
		transition: opacity 0.18s ease;
	}
	.post-list a:hover .arrow,
	.post-list a:focus-visible .arrow {
		opacity: 1;
	}

	@media (max-width: 720px) {
		.post-list a {
			grid-template-columns: auto 1fr;
			gap: 0.8em;
		}
		.thumb,
		.arrow {
			display: none;
		}
	}
</style>
